CALL <IO> FROM <STD>
CALL <BANK> FROM <STD>

PROGRAM -HELLOWORLD {
    PROCEDURE .main() {
        IO.PRINT("HelloWorld");
    };

    RETURN 0; 
};

// operators

ADD // addition 
SUB  // subtraction 
MULTI  // multiply
DIV // division 

AND // logical AND
OR // logical OR 

B-AND // bitwise AND
B-OR // bitwise OR 

. // dot-notation 

-PLUS-PLUS // increment

-MINUS-MINUS // decrement

LESS-THAN // < 
MORE-THAN // >

LESS-THAN-EQUALS // <=
MORE-THAN-EQUALS // >=

MODULO // % 

ASSIGN // =
COMPARE // ==

NEGATE // !

// IoCyc // Internet of Cycobol 

PROGRAM // Program entry point 

PROCEDURE // Function 

RETURN 0; // Exits Program 

// variables 

INTEGER // 16 Bit integer 

L-INTEGER // 32 Bit intger 

FLOAT // 32 bit float, COMP-1

DOUBLE // 64 bit float, COMP-2

CHAR // character 

L-CHAR // long Character

// arrays 

INTEGER my_arr[4] ASSIGN {1,2,3,4}; // array of 16 bit integers 

L-INTEGER my_l_arr[4] ASSIGN {1,2,3,4}; // array of 32 bit integers

FLOAT my_f_arr[4] ASSIGN {1.0,2.0,3.0,4.0}; // array of 32bit floats, COMP-1

DOUBLE my_d_arr[4] ASSIGN {1.00,2.00,3.00,4.00}; // array of 64bit floats, COMP-2

CHAR my_c_arr[4] ASSIGN {'a','b','c','d'}; // array of char's 

L-CHAR my_l_c_arr[4] ASSIGN {'a','b','c','d'}; // array of long char's

// immutable variables 


CONSTANT INTEGER // 16 Bit integer, immutable

CONSTANT L-INTEGER // 32 Bit intger, immutable

CONSTANT FLOAT // 32 bit float, immutable, COMP-1

CONSTANT DOUBLE // 64 bit float, immutable, COMP-2

CONSTANT CHAR // character, immutable

CONSTANT L-CHAR // long character, immutable

// immutable arrays 

CONSTANT INTEGER my_i_arr[4] ASSIGN {1,2,3,4}; // array of 16 bit integers, immutable

CONSTANT L-INTEGER my_i_l_arr[4] ASSIGN {1,2,3,4}; // array of 32 bit integers, immutable

CONSTANT FLOAT my_i_f_arr[4] ASSIGN {1.0,2.0,3.0,4.0}; // array of 32bit floats, immutable, COMP-1

CONSTANT DOUBLE my_i_d_arr[4] ASSIGN {1.00,2.00,3.00,4.00}; // array of 64bit floats, immutable, COMP-2

CONSTANT CHAR my_c_arr[4] ASSIGN {'a','b','c','d'}; // array of char's, immutable

CONSTANT L-CHAR my_l_c_arr[4] ASSIGN {'a','b','c','d'}; // array of long char's, immutable

// <------------------->

// example of adding 

INTEGER O ASSIGN 1; 
INTEGER P ASSIGN 1; 

O ASSIGN O ADD P; // = 2 

// example of subtraction 

INTEGER L ASSIGN 2; 
INTEGER Y ASSIGN 1; 

Y ASSIGN Y SUB L; // = 1

// <------------------->

// For loops

// new var
FOR(INTEGER k ASSIGN 1; k LESS-THAN-EQUALS 100; k-PLUS-PLUS) {
    // do something
};

// old var 

FOR(O; O LESS-THAN-EQUALS 100; O-PLUS-PLUS) {
    // do something
};

// FizzBuzz

FOR(INTEGER i ASSIGN 1; i LESS-THAN-EQUALS 100; i-PLUS-PLUS) {
    IF (i MODULO 15 COMPARE 0) {
        IO.PRINT("FizzBuzz");
    } ELSE IF (i MODULO 3 COMPARE 0) {
        IO.PRINT("Fizz");
    } ELSE IF (i MODULO 5 COMPARE 0) {
        IO.PRINT("Buzz");
    } ELSE {
        IO.PRINT(i);
    };
}; 

// error handling
THROW ERRNO // basic error throw

TRY {
    CATCH {

    };
}; 

ON SIZE[/*procedure or variable here*/] ERR {

};

RETURN -1; // Exit with failure

// using if statements for errors

FLOAT account_balance ASSIGN 100.0;
FLOAT max_account_balance ASSIGN 100000.0;

IF (account_balance MORE-THAN max_account_balance {
   IO.ERR("too much monies!");
   account_balance ASSIGN 100000.0;
   THROW ERRNO;
};

// structs / how to bank this shit

PROGRAM -BANK {

 STRUCT vars {
    INTEGER transfers_lifetime;
    FLOAT account_balance;
    FLOAT max_account_balance; 
    PROCEDURE .account_1() {
        STRUCT Account_1 {
            transfers_lifetime;
            account_balance ASSIGN 100.0;
            max_account_balance ASSIGN 1000.0;
        };

    };
    PROCEDURE .account_2() {
        STRUCT Account_2 {
            transfers_lifetime;
            account_balance ASSIGN 200.0;
            max_account_balance ASSIGN 10000.0;
        }

    }
 };

  PROCEDURE .bank(critical ASSIGN vars) {

    PROCEDURE .transfers() {
        IF (critical.account_1().Account_1.account_balance TRANSFERS 50.0 TO critical.account_2().Account_2.account_balance) {
            ON critical.account_1().Account_1.account_balance SUB 50.0; 
            ON critical.account_2().Account_2.account_balance ADD 50.0;

            ON critical.account_1().Account_1.transfers_lifetime ADD 1;
        };
    };
  };

  RETURN 0;
};

// Cycobol uses IBM 370 floating point format, if you don't like that do:
// CALL <IEEE_FLOAT> FROM <STD>

// the science of ON

ON /*Event*/ {}; // this is an event 

// so as an example

ON someprocedure().somestruct.somevariable ADD 1; // this is an event 

